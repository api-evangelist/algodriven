{"info":{"_postman_id":"26090bc4-bf13-4d53-a1ef-e29e98a87f48","name":"Vehicle History Report - UAE","description":"<html><head></head><body><h1 id=\"introduction\">Introduction</h1>\n<p>The Vehicle History Report - UAE generates and retrieves vehicle history reports, in PDF format, for vehicles in the United Arab Emirates.</p>\n<h1 id=\"overview\">Overview</h1>\n<p>The API works in two parts - the generation of the PDF and the retrieval.  Note that generation may take up to sixty seconds, so we recommend polling the retrieval API endpoint at five second intervals until a URL is returned successfully.</p>\n<h1 id=\"authentication\">Authentication</h1>\n<p>Authentication is via API key.</p>\n</body></html>","schema":"https://schema.getpostman.com/json/collection/v2.0.0/collection.json","toc":[{"content":"Introduction","slug":"introduction"},{"content":"Overview","slug":"overview"},{"content":"Authentication","slug":"authentication"}],"owner":"409572","collectionId":"26090bc4-bf13-4d53-a1ef-e29e98a87f48","publishedId":"Tzedg4A5","public":true,"customColor":{"top-bar":"FFFFFF","right-sidebar":"303030","highlight":"03254c"},"publishDate":"2021-06-25T07:19:18.000Z"},"item":[{"name":"Generate History Report","id":"4090c89f-1562-4294-883d-0433e0d8b615","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[{"key":"Authorization","value":"","type":"text"}],"body":{"mode":"formdata","formdata":[{"key":"vin","value":"","description":"<p><strong>Required</strong>\nSeventeen character vehicle identification code.</p>\n","type":"text"}]},"url":"https://algodriven.io/v1/generateGccHistoryReport","auth":{"type":"apikey","apikey":{"key":"<key>"},"isInherited":true,"source":{"_postman_id":"26090bc4-bf13-4d53-a1ef-e29e98a87f48","id":"26090bc4-bf13-4d53-a1ef-e29e98a87f48","name":"Vehicle History Report - UAE","type":"collection"}},"urlObject":{"protocol":"https","path":["v1","generateGccHistoryReport"],"host":["algodriven","io"],"query":[],"variable":[]}},"response":[],"_postman_id":"4090c89f-1562-4294-883d-0433e0d8b615"},{"name":"Retrieve History Report","id":"3a8f666f-4dc7-4338-ba34-ae0973fba8fc","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[{"key":"Authorization","value":"","type":"text"}],"body":{"mode":"formdata","formdata":[{"key":"reportId","value":"","description":"<p><strong>Required</strong>\nThe unique report ID generation from the generate endpoint.</p>\n","type":"text"}]},"url":"https://algodriven.io/v1/retrieveGccHistoryReport","auth":{"type":"apikey","apikey":{"key":"<key>"},"isInherited":true,"source":{"_postman_id":"26090bc4-bf13-4d53-a1ef-e29e98a87f48","id":"26090bc4-bf13-4d53-a1ef-e29e98a87f48","name":"Vehicle History Report - UAE","type":"collection"}},"urlObject":{"protocol":"https","path":["v1","retrieveGccHistoryReport"],"host":["algodriven","io"],"query":[],"variable":[]}},"response":[],"_postman_id":"3a8f666f-4dc7-4338-ba34-ae0973fba8fc"}],"auth":{"type":"apikey","apikey":{"key":"<key>"}},"event":[{"listen":"prerequest","script":{"id":"cf911044-a52c-4944-a31d-23f5084e9675","type":"text/javascript","exec":[""]}},{"listen":"test","script":{"id":"6db4e18c-4934-4667-8a60-d1ae78282635","type":"text/javascript","exec":[""]}}]}